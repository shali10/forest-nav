{
  "name": "forest-nav",
  "version": "1.0.0",
  "private": true,
  "description": "高饱和旅行海报风个人导航页，支持 Cloudflare Pages Functions。",
  "scripts": {
    "deploy": "wrangler pages deploy . --project-name=${PROJECT_NAME:-forest-nav} --branch=${BRANCH:-main} --commit-dirty=true",
    "check": "node --check functions/api/posts.js && node --check functions/api/weather.js"
  },
  "devDependencies": {
    "wrangler": "^4.127.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
